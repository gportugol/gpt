algoritmo control;
variáveis
  i, j, n, soma : inteiro;
  r : real;
fim-variáveis
início
  i := 5;
  se i > 3 então imprima("maior"); senão imprima("menor"); fim-se
  se i < 3 então imprima("menor"); senão imprima("maior"); fim-se
  se i = 5 então
    se i > 10 então imprima("a"); senão
      se i > 4 então imprima("b"); fim-se
    fim-se
  fim-se
  se falso então imprima("nunca"); fim-se
  se verdadeiro então fim-se
  se i > 0 então senão imprima("x"); fim-se
  i := 0;
  enquanto i < 5 faça
    imprima("enquanto ", i);
    i := i + 1;
  fim-enquanto
  imprima("depois: ", i);
  enquanto falso faça imprima("nunca"); fim-enquanto
  i := 0;
  repita
    imprima("repita ", i);
    i := i + 1;
  até i >= 3;
  repita imprima("uma vez"); até verdadeiro;
  para i de 1 até 5 faça imprima("para ", i); fim-para
  imprima("i apos para: ", i);
  para i de 5 até 1 passo -1 faça imprima("desc ", i); fim-para
  imprima("i apos desc: ", i);
  para i de 0 até 10 passo 3 faça imprima("passo3 ", i); fim-para
  imprima("i apos passo3: ", i);
  para i de 10 até 0 passo -4 faça imprima("passo-4 ", i); fim-para
  para i de 0 até 10 passo +2 faça imprima("passo+2 ", i); fim-para
  para i de 5 até 1 faça imprima("nao deveria: ", i); fim-para
  imprima("i apos vazio: ", i);
  para i de 1 até 5 passo -1 faça imprima("nao deveria2: ", i); fim-para
  para i de 3 até 3 faça imprima("uma vez ", i); fim-para
  para i de 1 até 10 faça
    se i = 4 então i := 100; fim-se
    imprima("break ", i);
  fim-para
  imprima("i apos break: ", i);
  soma := 0;
  para i de 1 até 3 faça
    para j de 1 até 3 faça
      soma := soma + i * j;
    fim-para
  fim-para
  imprima("soma ", soma);
  n := 4;
  para i de n-2 até n*2 faça imprima("expr ", i); fim-para
  i := 0;
  enquanto i < 10 faça
    i := i + 1;
    se i % 2 = 0 então
      imprima("par ", i);
    senão
      se i % 3 = 0 então imprima("mult3 ", i); senão imprima("outro ", i); fim-se
    fim-se
  fim-enquanto
fim
