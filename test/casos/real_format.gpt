algoritmo real_format;
variáveis
  r : real;
  i : inteiro;
fim-variáveis
início
  r := 0; imprima(r);
  r := 1; imprima(r);
  r := 1.1; imprima(r);
  r := 1.15; imprima(r);
  r := 1.25; imprima(r);
  r := 1.35; imprima(r);
  r := 2.675; imprima(r);
  r := 99.999; imprima(r);
  r := -1.005; imprima(r);
  r := 1000000; imprima(r);
  r := 12345678.9; imprima(r);
  imprima(5 / 2, " ", 5.0 / 2, " ", 5 / 2.0, " ", 5 * 1.0 / 2);
  imprima(7 % 3 * 1.0);
  i := 5 / 2; imprima(i);
  i := 5 / 2.0; imprima(i);
  i := -5 / 2; imprima(i);
  i := -2.5; imprima(i);
  i := 2.5; imprima(i);
  i := 3.5; imprima(i);
  i := -3.5; imprima(i);
  i := 0.9999; imprima(i);
  imprima(1.5 + 1, " ", 1 + 1.5, " ", 3 * 0.5, " ", 2 - 0.5);
  imprima(3.0 = 3, " ", 3.1 > 3, " ", 2.99 < 3);
  imprima(10 % 3);
fim
