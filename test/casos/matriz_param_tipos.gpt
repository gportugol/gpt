algoritmo matriz_param_tipos;
variáveis
  nomes : matriz[3] de literais;
  valores : matriz[2][2] de reais;
  flags : matriz[2] de lógicos;
  letras : matriz[3] de caracteres;
  i : inteiro;
fim-variáveis
início
  nomes[0] := "um"; nomes[1] := "dois"; nomes[2] := "três";
  valores[0][0] := 1.5; valores[0][1] := -2.25;
  valores[1][0] := 1000.125; valores[1][1] := 0.001;
  flags[0] := verdadeiro; flags[1] := falso;
  letras[0] := 'a'; letras[1] := 'b'; letras[2] := 'c';

  mostra_nomes(nomes);
  imprima(nomes[0], " ", nomes[1], " ", nomes[2]);
  imprima(soma_valores(valores));
  imprima(valores[0][0], " ", valores[0][1], " ", valores[1][0], " ", valores[1][1]);
  inverte_flags(flags);
  imprima(flags[0], " ", flags[1]);
  avanca_letras(letras);
  para i de 0 até 2 faça
    imprima(letras[i]);
  fim-para
fim

função mostra_nomes(m : matriz[3] de literais)
  i : inteiro;
início
  para i de 0 até 2 faça
    imprima(i, ": ", m[i]);
  fim-para
  m[0] := "alterado";
  imprima(m[0]);
fim

função soma_valores(m : matriz[2][2] de reais) : real
  i, j : inteiro;
  s : real;
início
  s := 0;
  para i de 0 até 1 faça
    para j de 0 até 1 faça
      s := s + m[i][j];
    fim-para
  fim-para
  m[0][0] := 99.5;
  retorne s;
fim

função inverte_flags(m : matriz[2] de lógicos)
início
  imprima(m[0], " ", m[1]);
  m[0] := não m[0];
  m[1] := não m[1];
  imprima(m[0], " ", m[1]);
fim

função avanca_letras(m : matriz[3] de caracteres)
  i : inteiro;
início
  para i de 0 até 2 faça
    imprima(m[i]);
    m[i] := m[i] + 1;
  fim-para
fim
