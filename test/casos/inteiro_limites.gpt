algoritmo inteiro_limites;
variáveis
  i, j : inteiro;
  v : matriz[2] de inteiros;
fim-variáveis
início
  i := 2147483647; imprima(i);
  j := -2147483647; imprima(j);
  j := j - 1; imprima(j);
  imprima(i > j, " ", j < i, " ", i = 2147483647, " ", j <> i);
  imprima(i / 2, " ", j / 2, " ", i % 1000, " ", j % 1000);
  imprima(-i, " ", -j - 1);
  v[0] := i; v[1] := j;
  imprima(v[0], " ", v[1]);
  imprima(v[0] / 1000000, " ", v[1] / 1000000);
  i := 65536; imprima(i * 32767);
  i := -65536; imprima(i * 32767);
  imprima(1000000 * 2000, " ", -1000000 * 2000);
  imprima(7 / -2, " ", -7 / 2, " ", 7 % -2, " ", -7 % 2);
  imprima(2147483647 / -1, " ", 0 - 2147483647 - 1);
fim
