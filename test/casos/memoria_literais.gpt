algoritmo memoria_literais;
variáveis
  s, a, b, c : literal;
  v : matriz[3] de literais;
  i : inteiro;
fim-variáveis
início
  a := leia();
  para i de 1 até 3000 faça
    s := longo();
    se i = 1500 então
      b := leia();
      v[0] := eco(b);
    fim-se
  fim-para
  c := leia();
  v[1] := c;
  v[2] := eco(v[1]);
  imprima(a, " ", b, " ", c, " ", v[0], " ", v[1], " ", v[2]);
  imprima(s = longo(), " ", v[2] = c, " ", v[0] <> c, " ", eco(s) = s);
fim

função longo() : literal
início
  retorne "";
fim

função eco(x : literal) : literal
início
  retorne x;
fim
