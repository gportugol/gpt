algoritmo arrays;
variáveis
  v : matriz[5] de inteiros;
  m : matriz[3][3] de inteiros;
  c : matriz[2][2][2] de inteiros;
  rs : matriz[3] de reais;
  cs : matriz[3] de caracteres;
  ss : matriz[2] de literais;
  ls : matriz[2] de lógicos;
  i, j, k : inteiro;
fim-variáveis
início
  imprima("inicial: ", v[0], " ", rs[0], " ", cs[0], " [", ss[0], "] ", ls[0]);
  para i de 0 até 4 faça v[i] := i * i; fim-para
  para i de 0 até 4 faça imprima(v[i]); fim-para
  imprima(v[1+1], " ", v[v[1]], " ", v[4-4]);
  para i de 0 até 2 faça
    para j de 0 até 2 faça
      m[i][j] := i * 3 + j;
    fim-para
  fim-para
  para i de 0 até 2 faça imprima(m[i][0], " ", m[i][1], " ", m[i][2]); fim-para
  para i de 0 até 1 faça para j de 0 até 1 faça para k de 0 até 1 faça
    c[i][j][k] := i * 4 + j * 2 + k;
  fim-para fim-para fim-para
  imprima(c[1][1][1], " ", c[0][1][0], " ", c[1][0][1]);
  rs[0] := 1.5; rs[1] := rs[0] * 2; rs[2] := 7;
  imprima(rs[0], " ", rs[1], " ", rs[2]);
  cs[0] := 'x'; cs[1] := 'y'; cs[2] := cs[0];
  imprima(cs[0], cs[1], cs[2]);
  ss[0] := "olá"; ss[1] := ss[0];
  imprima(ss[0], " ", ss[1]);
  ls[0] := verdadeiro; ls[1] := não ls[0];
  imprima(ls[0], " ", ls[1]);
  v[m[0][1]] := 77;
  imprima(v[1]);
  i := 2;
  v[i] := v[i] + v[i-1];
  imprima(v[2]);
  m[1][1] := m[0][0] + m[2][2];
  imprima(m[1][1]);
  imprima(v[0] + v[1] * 2 - m[1][2]);
  preenche(v);
  imprima(v[0], " ", v[4]);
  imprima(soma_m(m));
  v[0] := 3.7; imprima(v[0]);
  rs[1] := 2; imprima(rs[1]);
fim

função preenche(a: matriz[5] de inteiros)
  i : inteiro;
início
  para i de 0 até 4 faça a[i] := -i; fim-para
fim

função soma_m(a: matriz[3][3] de inteiros): inteiro
  i, j, s : inteiro;
início
  s := 0;
  para i de 0 até 2 faça para j de 0 até 2 faça s := s + a[i][j]; fim-para fim-para
  retorne s;
fim
